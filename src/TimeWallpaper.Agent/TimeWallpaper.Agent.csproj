<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Background runtime: tray, scheduler, wallpaper reconciliation, system event handling.
    MUST NOT reference TimeWallpaper.App, TimeWallpaper.AI, or WinUI.
    Tray and scheduler are not implemented in Task 01; only a minimal process entry point.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TimeWallpaper.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeWallpaper.Core\TimeWallpaper.Core.csproj" />
    <ProjectReference Include="..\TimeWallpaper.Themes\TimeWallpaper.Themes.csproj" />
    <ProjectReference Include="..\TimeWallpaper.Rendering\TimeWallpaper.Rendering.csproj" />
    <ProjectReference Include="..\TimeWallpaper.Platform.Windows\TimeWallpaper.Platform.Windows.csproj" />
    <ProjectReference Include="..\TimeWallpaper.Content\TimeWallpaper.Content.csproj" />
  </ItemGroup>

</Project>
